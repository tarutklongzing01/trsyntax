rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    match /public/{allPaths=**} { allow read: if true; allow write: if isAdmin(); }
    match /free-software/{allPaths=**} { allow read: if signedIn(); allow write: if isAdmin(); }
    // Paid binaries stay private. Serve them through a trusted backend that verifies
    // the user's ID token and active license, then returns a short-lived signed URL.
    match /paid-software/{allPaths=**} { allow read, write: if isAdmin(); }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
